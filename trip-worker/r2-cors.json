{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://rongwuxu.com",
          "https://www.rongwuxu.com",
          "https://pillowsofwind.github.io",
          "http://localhost:5500",
          "http://127.0.0.1:5500",
          "http://localhost:8000",
          "http://127.0.0.1:8000"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 86400
    }
  ]
}
